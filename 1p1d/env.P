# f1 = PREFILL pool (kv_producer) — Qwen3.8-Flash-Next 1P1D PoC (plan §6 E0/E1).
# Part of the 1P1D fork of MiaAI-Lab/Qwen3.8-Flash-Next-Single-DGX-Spark — AGPL-3.0-or-later.
# Base: single-Spark recipe known-good profile (.env.sample) + PoC overrides.
# Reserve-table rule: stock Mia ckpt + MAX_NUM_SEQS=8 => HOST_RESERVE_GIB=28.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
ABLIT=0
YARN=1
MAX_MODEL_LEN=262144
MTP_NUM_SPECULATIVE_TOKENS=3
KV_TARGET_GIB=20
HOST_RESERVE_GIB=28
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
MAX_NUM_SEQS=8
CUDAGRAPH_CAPTURE_SIZES=auto
MAX_NUM_BATCHED_TOKENS=2048
MTP_DRAFT_VOCAB=files/draft_vocab_en_code_47k.txt
MTP_K_SCHEDULE=
COMPILATION_MODE=0
MTP_DISABLE_BLOCK_DROP=1
CHAT_TEMPLATE=
HOST_SLACK_GIB=5
PORT=8000
KV_TRANSFER_ROLE=kv_producer
# Seam pins (27B-proven env block, adapted): side channel binds the LAN IP
# (reachable by any consumer — f2 today, a LAN D-pool in E4), data plane rides
# the CX-7 fabric via UCX_NET_DEVICES=roceP2p1s0f1 (both P/D ends are ON the
# fabric, so UCX advertising fabric endpoints is the wanted behavior here,
# unlike the 27B 3090 seam which pinned the LAN NIC for it).
EXTRA_DOCKER_ARGS="--device /dev/infiniband -e VLLM_USE_V2_MODEL_RUNNER=1 -e GLOO_SOCKET_IFNAME=enP2p1s0f1np1 -e NCCL_SOCKET_IFNAME=enP2p1s0f1np1 -e TP_SOCKET_IFNAME=enP2p1s0f1np1 -e VLLM_HOST_IP=192.168.100.1 -e UCX_TLS=rc,cuda_copy,sm,self -e UCX_NET_DEVICES=roceP2p1s0f1 -e VLLM_NIXL_SIDE_CHANNEL_HOST=192.168.2.190 -e VLLM_SSM_CONV_STATE_LAYOUT=DS"
