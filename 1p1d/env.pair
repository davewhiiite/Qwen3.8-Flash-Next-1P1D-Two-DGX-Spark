# 1p1d/env.pair — user/host pins for the two-Spark pair.
# Part of the 1P1D fork of MiaAI-Lab/Qwen3.8-Flash-Next-Single-DGX-Spark — AGPL-3.0-or-later.
# start-pair.sh runs ON box 1 (prefill). The values below are OUR REFERENCE
# RIG, shipped as a worked example — EDIT THEM for your rig before starting.
# Keep this file identical on both boxes (box 2 reads its own copy for its
# launch).

# ---- Box 1: prefill / kv_producer (this script runs here, no ssh needed) ----
P_REPO="$HOME/Qwen3.8-Flash-Next-Single-DGX-Spark"   # upstream repo clone on box 1
P_HEALTH="http://127.0.0.1:8000"        # P /health, as seen from box 1
P_SIDECHANNEL_IP="192.168.2.190"        # box 1 LAN IP (NIXL side-channel host pin)

# ---- Box 2: decode / kv_consumer (ssh-driven) ----
D_SSH="foundation2@192.168.2.193"       # ssh alias or user@ip of box 2
D_REPO="/home/foundation2/Qwen3.8-Flash-Next-Single-DGX-Spark"  # repo clone on box 2
D_HEALTH="http://192.168.2.193:8100"    # D /health, as seen from box 1 (LAN)
D_FABRIC_URL="http://192.168.100.2:8100" # D over the 200G fabric — the router's pin

# ---- PD router (runs on box 1, host network, in the required image) ----
ROUTER_CONTAINER="gattling-router"
ROUTER_PORT="8200"
ROUTER_HEALTH="http://127.0.0.1:8200"

# ---- Shared ----
IMAGE="vllm/vllm-openai:qwen38-flash-next"   # their required image
P_CONTAINER="vllm-fn-tp1"               # upstream start.sh default name (box 1)
D_CONTAINER="vllm-fn-tp1"               # same default on box 2 (separate host)

# Boot-order note: the decode pool connects to the prefill pool's NIXL side
# channel at engine init, so P is gated healthy BEFORE D is launched. Cold
# start is therefore ~2x a single box (~11 min/box incl. the ~27 GB PLE table
# build on first launch). GATE_TIMEOUT_S is per node.
GATE_TIMEOUT_S="${GATE_TIMEOUT_S:-2400}"
